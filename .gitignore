# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Large binaries, models, and archive formats
*.tar.gz
*.tar
*.gz
*.zip
*.bin
*.pkl
*.part

# Data directories (do NOT commit full datasets or large indices)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/indices/*
!data/indices/.gitkeep
data/qrels/*
!data/qrels/.gitkeep

# Keep the small 5-doc sample data tracked for testing
!data/sample/*

# Logs and transient outputs
logs/
*.log
runs/

# IDE / OS specific
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
